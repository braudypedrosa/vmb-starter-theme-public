            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "message": "Available Shortcodes:\r\n<strong>[booking_engine]<\/strong> - displays the booking engine (Requires \"Site Name\" to be filled in Site Settings)\r\n<strong>[discount_cards]<\/strong> - display all discount cards from the Main VMB site.\r\n<strong>[display_category category=\"**\"]<\/strong> - display all specials in a category. (category is a required field)\r\n<strong>[vmb_gallery id=\"**\"]<\/strong> - display VMB style gallery. (id is a required field)\r\n<strong>[vmb_rooms]<\/strong> - display all available rooms in VMB style.\r\n<strong>[vmb_specials]<\/strong> - display all available specials. (Need to run sync specials first from VMB Widgets Settings)\r\n<strong>[vmb_reviews]<\/strong> - display all available reviews. (Need to run sync reviewsd first from VMB Widgets Settings)",
            "new_lines": "wpautop",
            "esc_html": 0
        }
